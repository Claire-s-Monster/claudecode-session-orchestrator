"""
{component_name}: Basic atomic component for session orchestration.

Atomic design level: ATOM
Purpose: {component_purpose}
Thread-safe: Yes
Async patterns: Full async/await support
Python version: 3.12+
"""

import asyncio
import logging
from abc import ABC, abstractmethod
from dataclasses import dataclass, field
from enum import Enum, auto
from typing import Any, TypeVar, Generic
from uuid import uuid4


# Type definitions
T = TypeVar("T")
ComponentId = str


class ComponentStatus(Enum):
    """Status enumeration for component lifecycle."""

    INITIALIZING = auto()
    READY = auto()
    ACTIVE = auto()
    ERROR = auto()
    SHUTDOWN = auto()


class ComponentError(Exception):
    """Base exception for component-level errors."""
    pass


class ComponentInitializationError(ComponentError):
    """Raised when component initialization fails."""
    pass


class ComponentOperationError(ComponentError):
    """Raised when component operation fails."""
    pass


@dataclass
class ComponentConfig:
    """Configuration parameters for atomic components."""

    # Component identification
    component_id: str = field(default_factory=lambda: str(uuid4()))
    name: str = "{component_name}"
    description: str = "{component_description}"

    # Performance settings
    max_concurrent_operations: int = 5
    operation_timeout: float = 5.0

    # Logging configuration
    log_level: str = "INFO"
    enable_metrics: bool = True

    # Resource limits
    max_memory_mb: int = 100
    max_cpu_percent: float = 10.0

    def __post_init__(self) -> None:
        """Validate configuration after initialization."""
        if self.max_concurrent_operations <= 0:
            raise ValueError("max_concurrent_operations must be positive")
        if self.operation_timeout <= 0:
            raise ValueError("operation_timeout must be positive")


@dataclass
class ComponentMetrics:
    """Performance and operational metrics for components."""

    component_id: str
    operations_count: int = 0
    total_operation_time: float = 0.0
    error_count: int = 0
    last_operation_time: float | None = None
    average_operation_time: float = 0.0

    def record_operation(self, duration: float, success: bool = True) -> None:
        """Record operation metrics."""
        self.operations_count += 1
        self.total_operation_time += duration
        self.last_operation_time = duration

        if not success:
            self.error_count += 1

        # Update average
        if self.operations_count > 0:
            self.average_operation_time = self.total_operation_time / self.operations_count


class BaseComponent(ABC, Generic[T]):
    """Abstract base class for atomic components in session orchestration.

    Provides:
    - Async lifecycle management
    - Thread-safe operations
    - Performance monitoring (<5% overhead requirement)
    - Comprehensive error handling
    - Resource management
    """

    def __init__(self, config: ComponentConfig | None = None) -> None:
        """Initialize the component.

        Args:
            config: Component configuration. Uses defaults if None.
        """
        self.config = config or ComponentConfig()
        self._setup_logging()

        # Component state
        self._status = ComponentStatus.INITIALIZING
        self._lock = asyncio.Lock()
        self._shutdown_event = asyncio.Event()

        # Performance tracking
        self.metrics = ComponentMetrics(component_id=self.config.component_id)
        self._operation_semaphore = asyncio.Semaphore(
            self.config.max_concurrent_operations
        )

        self.logger.info(f"Initialized {self.config.name} (ID: {self.config.component_id})")

    def _setup_logging(self) -> None:
        """Setup component-specific logging."""
        self.logger = logging.getLogger(f"{__name__}.{self.config.name}")

        # Set log level
        log_level = getattr(logging, self.config.log_level.upper(), logging.INFO)
        self.logger.setLevel(log_level)

        # Configure handler if not already configured
        if not self.logger.handlers:
            handler = logging.StreamHandler()
            formatter = logging.Formatter(
                f"%(asctime)s - {self.config.name} - %(levelname)s - %(message)s"
            )
            handler.setFormatter(formatter)
            self.logger.addHandler(handler)

    @property
    def component_id(self) -> ComponentId:
        """Get component unique identifier."""
        return self.config.component_id

    @property
    def status(self) -> ComponentStatus:
        """Get current component status."""
        return self._status

    @property
    def is_ready(self) -> bool:
        """Check if component is ready for operations."""
        return self._status == ComponentStatus.READY

    @property
    def is_active(self) -> bool:
        """Check if component is actively processing."""
        return self._status == ComponentStatus.ACTIVE

    async def __aenter__(self) -> "BaseComponent[T]":
        """Async context manager entry."""
        await self.initialize()
        return self

    async def __aexit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None:
        """Async context manager exit."""
        await self.shutdown()

    async def initialize(self) -> None:
        """Initialize the component.

        Raises:
            ComponentInitializationError: If initialization fails.
        """
        async with self._lock:
            if self._status != ComponentStatus.INITIALIZING:
                raise ComponentInitializationError(
                    f"Component already initialized with status: {self._status}"
                )

            try:
                await self._initialize_component()
                self._status = ComponentStatus.READY
                self.logger.info(f"Component {self.config.name} initialized successfully")

            except Exception as e:
                self._status = ComponentStatus.ERROR
                self.logger.error(f"Component initialization failed: {e}")
                raise ComponentInitializationError(f"Initialization failed: {e}") from e

    @abstractmethod
    async def _initialize_component(self) -> None:
        """Component-specific initialization logic.

        Override this method to implement custom initialization.
        """
        pass

    async def shutdown(self) -> None:
        """Shutdown the component and cleanup resources."""
        async with self._lock:
            if self._status == ComponentStatus.SHUTDOWN:
                return

            self.logger.info(f"Shutting down component {self.config.name}")
            self._shutdown_event.set()

            try:
                await self._shutdown_component()
                self._status = ComponentStatus.SHUTDOWN
                self.logger.info(f"Component {self.config.name} shutdown complete")

            except Exception as e:
                self.logger.error(f"Error during component shutdown: {e}")
                self._status = ComponentStatus.ERROR

    @abstractmethod
    async def _shutdown_component(self) -> None:
        """Component-specific shutdown logic.

        Override this method to implement custom cleanup.
        """
        pass

    async def execute_operation(
        self,
        operation_name: str,
        operation_func: callable,
        *args: Any,
        **kwargs: Any
    ) -> T:
        """Execute an operation with performance tracking and error handling.

        Args:
            operation_name: Name of the operation for logging/metrics.
            operation_func: Async function to execute.
            *args: Positional arguments for operation_func.
            **kwargs: Keyword arguments for operation_func.

        Returns:
            Result of the operation.

        Raises:
            ComponentOperationError: If operation fails.
        """
        if not self.is_ready:
            raise ComponentOperationError(
                f"Component not ready. Status: {self._status}"
            )

        async with self._operation_semaphore:
            start_time = asyncio.get_event_loop().time()

            try:
                self._status = ComponentStatus.ACTIVE
                self.logger.debug(f"Starting operation: {operation_name}")

                # Execute with timeout
                result = await asyncio.wait_for(
                    operation_func(*args, **kwargs),
                    timeout=self.config.operation_timeout
                )

                # Record successful operation
                duration = asyncio.get_event_loop().time() - start_time
                if self.config.enable_metrics:
                    self.metrics.record_operation(duration, success=True)

                self.logger.debug(
                    f"Operation {operation_name} completed in {duration:.3f}s"
                )

                return result

            except asyncio.TimeoutError as e:
                duration = asyncio.get_event_loop().time() - start_time
                if self.config.enable_metrics:
                    self.metrics.record_operation(duration, success=False)

                error_msg = f"Operation {operation_name} timed out after {self.config.operation_timeout}s"
                self.logger.error(error_msg)
                raise ComponentOperationError(error_msg) from e

            except Exception as e:
                duration = asyncio.get_event_loop().time() - start_time
                if self.config.enable_metrics:
                    self.metrics.record_operation(duration, success=False)

                error_msg = f"Operation {operation_name} failed: {e}"
                self.logger.error(error_msg)
                raise ComponentOperationError(error_msg) from e

            finally:
                self._status = ComponentStatus.READY

    def get_metrics(self) -> dict[str, Any]:
        """Get component performance metrics.

        Returns:
            Dictionary containing performance metrics.
        """
        return {
            "component_id": self.metrics.component_id,
            "component_name": self.config.name,
            "status": self._status.name,
            "operations_count": self.metrics.operations_count,
            "total_operation_time": self.metrics.total_operation_time,
            "average_operation_time": self.metrics.average_operation_time,
            "error_count": self.metrics.error_count,
            "error_rate": (
                self.metrics.error_count / self.metrics.operations_count
                if self.metrics.operations_count > 0 else 0
            ),
            "last_operation_time": self.metrics.last_operation_time,
            "performance_overhead_percent": self._calculate_overhead(),
            "meets_5_percent_requirement": self._meets_performance_requirement(),
        }

    def _calculate_overhead(self) -> float:
        """Calculate performance overhead percentage."""
        if self.metrics.operations_count == 0:
            return 0.0

        # Baseline: assume ideal operation time is 100ms
        baseline_time = 0.1
        actual_avg_time = self.metrics.average_operation_time

        if baseline_time > 0:
            overhead = ((actual_avg_time - baseline_time) / baseline_time) * 100
            return max(0.0, overhead)

        return 0.0

    def _meets_performance_requirement(self) -> bool:
        """Check if component meets <5% performance overhead requirement."""
        overhead_percent = self._calculate_overhead()
        return overhead_percent < 5.0

    async def health_check(self) -> dict[str, Any]:
        """Perform component health check.

        Returns:
            Health status information.
        """
        return {
            "component_id": self.component_id,
            "component_name": self.config.name,
            "status": self._status.name,
            "is_healthy": self._status in {ComponentStatus.READY, ComponentStatus.ACTIVE},
            "uptime_seconds": asyncio.get_event_loop().time(),
            "metrics": self.get_metrics(),
        }


