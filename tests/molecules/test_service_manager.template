    @pytest.mark.asyncio
    async def test_real_service_lifecycle(self, service_manager: {ServiceManagerClass}):
        """Test with a more realistic service implementation."""

        class DatabaseService:
            def __init__(self, db_url: str = "mock://db"):
                self.db_url = db_url
                self.connected = False

            async def start(self) -> None:
                # Simulate database connection
                await asyncio.sleep(0.01)
                self.connected = True

            async def stop(self) -> None:
                self.connected = False

            async def is_running(self) -> bool:
                return self.connected

            async def health_check(self) -> dict[str, Any]:
                return {
                    "is_healthy": self.connected,
                    "db_url": self.db_url,
                    "connection_status": "connected" if self.connected else "disconnected"
                }

        def db_factory(**kwargs: Any) -> DatabaseService:
            return DatabaseService(kwargs.get("db_url", "test://db"))

        # Test full lifecycle
        await service_manager.start_service(
            "database",
            db_factory,
            db_url="test://localhost:5432"
        )

        # Verify service is running
        db_service = await service_manager.get_service("database")
        assert db_service is not None
        assert await db_service.is_running()

        # Test health check
        health = await db_service.health_check()
        assert health["is_healthy"] is True
        assert "test://localhost:5432" in health["db_url"]

        # Test restart
        await service_manager.restart_service("database")

        # Should still be running
        assert await db_service.is_running()

        # Cleanup
        await service_manager.stop_service("database")
        assert not await db_service.is_running()


# Performance benchmarks
class Test{ServiceManagerClass}Performance:
    """Performance benchmark tests for {ServiceManagerClass}."""

    @pytest.mark.asyncio
    @pytest.mark.benchmark
    async def test_service_startup_performance(self, mock_service_factory):
        """Benchmark service startup performance."""
        config = ServiceConfig(
            service_name="benchmark_test",
            max_concurrent_operations=20
        )

        async with {ServiceManagerClass}(config) as manager:
            # Benchmark multiple service startups
            service_count = 50

            start_time = time.time()

            start_tasks = [
                manager.start_service(
                    f"bench_service_{i}",
                    mock_service_factory,
                    name=f"bench_service_{i}"
                )
                for i in range(service_count)
            ]

            results = await asyncio.gather(*start_tasks)

            end_time = time.time()
            total_time = end_time - start_time

            # Verify all started successfully
            assert all(result is True for result in results)

            # Performance assertions
            avg_startup_time = total_time / service_count
            services_per_second = service_count / total_time

            assert avg_startup_time < 0.1, f"Average startup time {avg_startup_time:.4f}s too high"
            assert services_per_second > 50, f"Services per second {services_per_second:.2f} too low"

            # Cleanup
            await manager.stop_all_services()

    @pytest.mark.asyncio
    @pytest.mark.benchmark
    async def test_health_monitoring_performance(self, mock_service_factory):
        """Benchmark health monitoring overhead."""
        config = ServiceConfig(
            service_name="health_benchmark",
            health_check_interval=0.01,  # 10ms - very frequent
            enable_auto_restart=False
        )

        async with {ServiceManagerClass}(config) as manager:
            # Start services
            service_count = 10
            for i in range(service_count):
                await manager.start_service(
                    f"health_service_{i}",
                    mock_service_factory,
                    name=f"health_service_{i}"
                )

            # Let health monitoring run
            start_time = time.time()
            await asyncio.sleep(1.0)  # 1 second
            end_time = time.time()

            # Check metrics
            metrics = manager.get_service_metrics()

            # Should have performed many health checks
            expected_checks = service_count * (1.0 / 0.01)  # rough estimate
            assert metrics["health_check_count"] > expected_checks * 0.5  # Allow some variance

            # Performance should still be acceptable
            base_metrics = manager.get_metrics()
            assert base_metrics["meets_5_percent_requirement"] is True

            # Cleanup
            await manager.stop_all_services()
