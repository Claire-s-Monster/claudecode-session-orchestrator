    @pytest.mark.asyncio
    async def test_service_auto_restart(self, mock_service_factory):
        """Test automatic service restart on health failure."""
        # Create config with auto-restart enabled
        config = ServiceConfig(
            service_name="auto_restart_test",
            health_check_interval=0.05,
            enable_auto_restart=True
        )

        async with {ServiceManagerClass}(config) as manager:
            service_name = "auto_restart_service"

            # Mock the restart_service method to track calls
            restart_called = False
            original_restart = manager.restart_service

            async def mock_restart(name: str) -> bool:
                nonlocal restart_called
                restart_called = True
                return await original_restart(name)

            manager.restart_service = mock_restart

            # Start service with unhealthy mock
            await manager.start_service(
                service_name,
                mock_service_factory,
                name=service_name,
                fail_health=True
            )

            # Wait for health checks and potential restart
            await asyncio.sleep(0.2)

            # Auto-restart should have been triggered
            # Note: This test may be flaky depending on timing
            # In a real implementation, you might want to use events or callbacks

            # Cleanup
            await manager.stop_service(service_name)

    @pytest.mark.asyncio
    async def test_service_dependencies(self, service_manager: {ServiceManagerClass}, mock_service_factory):
        """Test service dependency management."""
        # Create config with dependencies
        config = ServiceConfig(
            service_name="dependency_test",
            required_services=["dependency1", "dependency2"],
            dependency_timeout=1.0
        )

        manager = {ServiceManagerClass}(config)
        await manager.initialize()

        try:
            service_name = "dependent_service"

            # Starting service without dependencies should fail
            with pytest.raises(ServiceDependencyError, match="Dependencies not met"):
                await manager.start_service(
                    service_name,
                    mock_service_factory,
                    name=service_name
                )

            # Start dependencies first
            await manager.start_service(
                "dependency1",
                mock_service_factory,
                name="dependency1"
            )
            await manager.start_service(
                "dependency2",
                mock_service_factory,
                name="dependency2"
            )

            # Now dependent service should start successfully
            success = await manager.start_service(
                service_name,
                mock_service_factory,
                name=service_name
            )
            assert success is True

            # Cleanup
            await manager.stop_all_services()

        finally:
            await manager.shutdown()

    @pytest.mark.asyncio
    async def test_concurrent_service_operations(self, service_manager: {ServiceManagerClass}, mock_service_factory):
        """Test concurrent service operations."""

        # Start multiple services concurrently
        service_names = [f"concurrent_service_{i}" for i in range(5)]

        start_tasks = [
            service_manager.start_service(
                name,
                mock_service_factory,
                name=name
            )
            for name in service_names
        ]

        results = await asyncio.gather(*start_tasks)

        # All should succeed
        assert all(result is True for result in results)

        # Verify all services are running
        services = await service_manager.list_services()
        assert len(services) == 5

        # Stop all services concurrently
        stop_tasks = [
            service_manager.stop_service(name)
            for name in service_names
        ]

        stop_results = await asyncio.gather(*stop_tasks)
        assert all(result is True for result in stop_results)

        # Verify all services are stopped
        services = await service_manager.list_services()
        assert len(services) == 0

    @pytest.mark.asyncio
    async def test_service_metrics(self, service_manager: {ServiceManagerClass}, mock_service_factory):
        """Test service management metrics."""
        service_name = "metrics_test_service"

        # Start service
        await service_manager.start_service(
            service_name,
            mock_service_factory,
            name=service_name
        )

        # Get metrics
        metrics = service_manager.get_service_metrics()

        # Verify metrics structure
        required_fields = [
            "service_id", "service_name", "service_status",
            "managed_services_count", "start_count", "stop_count",
            "restart_count", "error_count"
        ]

        for field in required_fields:
            assert field in metrics, f"Missing metrics field: {field}"

        # Verify metrics values
        assert metrics["managed_services_count"] == 1
        assert metrics["start_count"] >= 1
        assert metrics["service_status"] == "RUNNING"

        # Stop service and check metrics again
        await service_manager.stop_service(service_name)

        updated_metrics = service_manager.get_service_metrics()
        assert updated_metrics["managed_services_count"] == 0
        assert updated_metrics["stop_count"] >= 1

    @pytest.mark.asyncio
    async def test_performance_overhead(self, mock_service_factory):
        """Test that service manager meets <5% performance overhead requirement."""
        # Create baseline: direct service operations
        service = mock_service_factory(name="baseline_service")

        # Measure baseline times
        start_time = time.time()
        await service.start()
        baseline_start_time = time.time() - start_time

        stop_start_time = time.time()
        await service.stop()
        baseline_stop_time = time.time() - stop_start_time

        # Measure service manager times
        config = ServiceConfig(
            service_name="performance_test",
            enable_metrics=True
        )

        async with {ServiceManagerClass}(config) as manager:
            # Start through service manager
            manager_start_time = time.time()
            await manager.start_service(
                "managed_service",
                mock_service_factory,
                name="managed_service"
            )
            manager_start_time = time.time() - manager_start_time

            # Stop through service manager
            manager_stop_start = time.time()
            await manager.stop_service("managed_service")
            manager_stop_time = time.time() - manager_stop_start

            # Calculate overhead
            start_overhead = ((manager_start_time - baseline_start_time) / baseline_start_time) * 100
            stop_overhead = ((manager_stop_time - baseline_stop_time) / baseline_stop_time) * 100

            # Should be less than 5% overhead
            assert start_overhead < 5.0, f"Start overhead {start_overhead:.2f}% exceeds 5%"
            assert stop_overhead < 5.0, f"Stop overhead {stop_overhead:.2f}% exceeds 5%"

            # Check component-level performance requirement
            base_metrics = manager.get_metrics()
            assert base_metrics["meets_5_percent_requirement"] is True

    @pytest.mark.asyncio
    async def test_error_recovery(self, service_manager: {ServiceManagerClass}, mock_service_factory):
        """Test error recovery capabilities."""
        service_name = "error_recovery_service"

        # Create a service that fails initially then succeeds
        failure_count = 0

        def recovery_factory(**kwargs: Any) -> MockService:
            nonlocal failure_count
            failure_count += 1
            # Fail first two attempts, succeed on third
            return MockService(service_name, fail_start=(failure_count <= 2))

        # First attempt should fail
        with pytest.raises(ServiceStartupError):
            await service_manager.start_service(service_name, recovery_factory)

        # Service should handle recovery gracefully
        metrics = service_manager.get_service_metrics()
        assert metrics["error_count"] >= 1

    @pytest.mark.asyncio
    async def test_service_context_manager(self, service_config: ServiceConfig):
        """Test service manager as async context manager."""
        async with {ServiceManagerClass}(service_config) as manager:
            assert manager.is_ready

            # Use manager within context
            await manager.start_service(
                "context_service",
                lambda **kwargs: MockService("context_service"),
                name="context_service"
            )

            services = await manager.list_services()
            assert len(services) == 1

        # After context, manager should be shutdown
        assert manager.status.name == "SHUTDOWN"


