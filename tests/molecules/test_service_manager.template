    @pytest.mark.asyncio
    async def test_stop_service_force(self, service_manager: {ServiceManagerClass}):
        """Test force stopping a service."""
        service_name = "force_stop_service"

        class UnstoppableService:
            async def start(self) -> None:
                pass

            async def stop(self) -> None:
                await asyncio.sleep(2.0)  # Longer than timeout

        def factory(**kwargs: Any) -> UnstoppableService:
            return UnstoppableService()

        # Start service
        await service_manager.start_service(service_name, factory)

        # Force stop should succeed
        success = await service_manager.stop_service(service_name, force=True)
        assert success is True

        # Service should be removed
        service_instance = await service_manager.get_service(service_name)
        assert service_instance is None

    @pytest.mark.asyncio
    async def test_restart_service(self, service_manager: {ServiceManagerClass}, mock_service_factory):
        """Test restarting a service."""
        service_name = "restart_test_service"

        # Start service
        await service_manager.start_service(
            service_name,
            mock_service_factory,
            name=service_name
        )

        # Get initial service instance
        initial_instance = await service_manager.get_service(service_name)
