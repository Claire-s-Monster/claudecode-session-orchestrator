class MockService:
    """Mock service for testing."""

    def __init__(self, name: str = "mock_service", fail_start: bool = False, fail_health: bool = False):
        self.name = name
        self.fail_start = fail_start
        self.fail_health = fail_health
        self._running = False

    async def start(self) -> None:
        if self.fail_start:
            raise Exception(f"Mock start failure for {self.name}")
        self._running = True

    async def stop(self) -> None:
        self._running = False

    async def is_running(self) -> bool:
        return self._running

    async def health_check(self) -> dict[str, Any]:
        return {
            "is_healthy": not self.fail_health,
            "name": self.name,
            "status": "healthy" if not self.fail_health else "unhealthy"
        }


